[Unit]
Description=Thyra WAN llama.cpp OpenAI-compatible server
After=network.target
Wants=network.target

[Service]
User=thyra
Group=thyra
SupplementaryGroups=render
Environment="PATH=/usr/local/cuda/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="LD_LIBRARY_PATH=/usr/local/cuda/lib64"
ExecStart=/home/thyra/llama.cpp/build/bin/llama-server \
    -m /home/thyra/models/Qwen3-8B-abliterated-Q4_K_M.gguf \
    --n-gpu-layers 99 \
    --ctx-size 4096 \
    --cache-type-k q8_0 \
    --cache-type-v q8_0 \
    --host 0.0.0.0 \
    --port 8080 \
    --log-disable
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
